# Example values only. Keep the file containing real secrets OUTSIDE the web checkout.
# Node 22.13+ supports: node --env-file=/private/path/commerce.env server/commerce.mjs
PORT=8432
BIND_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:8432
# Optional absolute database path OUTSIDE the public checkout, on a persistent disk.
# Default: ~/.local/share/meadowlark-ranch/commerce.sqlite
# COMMERCE_DB=/private/path/commerce.sqlite
# Server-key method (also supports hosted tests): set both values below.
# Live and publishable keys are rejected.
# Server test keys: sk_test_ (secret), rk_test_ (restricted), rkcs_test_ (temporary sandbox).
# Each prefix must be followed by a nonempty key value. Keep this value private.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Alternative local-only method: use the approved Stripe CLI test login.
# No STRIPE_SECRET_KEY is needed. Set the exact approved test account ID.
# STRIPE_CLI_PROJECT=meadowlark-test
# STRIPE_CLI_ACCOUNT=acct_REPLACEWITHYOURACCOUNTID
# Use tools/start-stripe-test.mjs with ~/.config/meadowlark-ranch/stripe-test.env
# to start the CLI listener and supply STRIPE_WEBHOOK_SECRET automatically.
# That launcher defaults to port 57875; set PORT and APP_ORIGIN to match.
