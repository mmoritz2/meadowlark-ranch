  "sourceSnippets": {
    "formation": " /* Sedimentary mesas and weathered spires with grounded talus skirts. */\n {\n  let seed=20260906;\n  const rnd=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};\n  for(const kind of ['mesa','hoodoo']){\n   let placed=0;const count=kind==='mesa'?13:26;\n   for(let i=0;i<320&&placed<count;i++){\n    const a=rnd()*Math.PI*2,rr=24+rnd()*108,x=CANYON.x+Math.cos(a)*rr,z=CANYON.z+Math.sin(a)*rr;\n    const radius=kind==='mesa'?7+rnd()*9:.9+rnd()*1.5;\n    if(Math.hypot(x-CANYON.x,z-CANYON.z)<18||pathDist(x,z)<radius+4||Math.abs(z-riverZ(x))<radius*1.3+9)continue;\n    const height=kind==='mesa'?7+rnd()*11:3.5+rnd()*6.5;\n    if(canyonReplacesFormation(x,z,radius)){placed++;continue;}\n    let placedFormation;\n    if(kind==='mesa')geology.placeMesa(x,z,radius,height,i+1107);\n    else placedFormation=geology.placeHoodoo(x,z,radius,height,i+3527);\n    const colliderHeight=placedFormation?.userData.geology.fieldstone?placedFormation.userData.geology.collisionHeight:height;\n    colliders.push({x,z,r:radius*.95,height:colliderHeight,landform:kind==='mesa'});placed++;   // landform: seeded, the same on every load, so course-clear may bend a route round it\n   }\n  }\n }\n",
    "extraMesas": "{let seed=20260929;const rnd=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};\nfor(let i=0;i<8;i++){\n const x=-160-rnd()*130,z=80+rnd()*110;\n const hgt=6+rnd()*9,rad=5+rnd()*7;\n if(Math.abs(z-riverZ(x))<rad*1.3+9||pathDist(x,z)<rad+3||Math.hypot(x-CANYON.x,z-CANYON.z)<50)continue;\n if(canyonReplacesFormation(x,z,rad))continue;\n geology.placeMesa(x,z,rad,hgt,i+8234);\n colliders.push({x,z,r:rad*.95,height:hgt,landform:true});\n}}\n"
  },
