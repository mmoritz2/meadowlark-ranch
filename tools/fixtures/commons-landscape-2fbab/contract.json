          "before": "import {FIELD_SWARD_BANDS,fieldSwardAt} from '../assets/field-sward-bands.mjs';",
          "after": "import {FIELD_SWARD_BANDS as ALL_FIELD_SWARD_BANDS,fieldSwardAt} from '../assets/field-sward-bands.mjs';\n// Preserve the original seven-bank .65/m gradient survey. The actual nine-bank\n// composed response receives its own bound/convergence test in commons-sward.\nconst FIELD_SWARD_BANDS=Object.freeze(ALL_FIELD_SWARD_BANDS.slice(0,7));",
          "occurrences": 1
        },
