          "after": "    northValley.plantsProposed=plants.filter(p=>northValley.trees.some(t=>Math.hypot(p.x-t.x,p.z-t.z)<8.5)).length;\n    commonsStandards.trees=commonsStandards.trees.map(t=>({id:t.id,x:t.x,z:t.z,height:t.height,yaw:t.yaw,margin:t.margin,source:t.source.key,lowWoodRadius:t.lowWoodRadius,fullWoodRadius:t.woodRadius,riderWoodRadius:t.riderWoodRadius,maxGroundRise:t.maxGroundRise,matrix:t.matrix.toArray()}));\n    commonsStandards.woodPartsRegistered=commonsStandards.trees.reduce((n,t)=>n+(t.source==='upright-broadleaf'?UPRIGHT_HYBRID_WOOD_BOXES.length:WOODLAND_WOOD_BOXES.length),0);",
