  "sourceSnippets": {
    "paths": "const PATHS=[\n ...COTTONWOOD_TRACKS,\n [[0,128],[0,138],[18,150],[47,171],[83,184]],                         // river crossing -> north meadow\n [[0,10],[13,-11],[28,-30],[44,-46],[50,-53]],                       // ranch -> Cottonwood\n [[-7,3],[-26,7],[-46,2],[-63,-6],[-71,-10]],                        // ranch -> Home Pasture\n [[2,15],[7,44],[4,72],[1,98],[0,112]],                              // ranch -> the river bridge\n [[53,-57],[96,-70],[140,-84],[184,-97],[214,-105]],                 // Cottonwood -> Barleyfold\n [[-30,-20],[-33,-38],[-31,-52],[-30,-58]],                          // pasture road -> Hollowpeak Pines\n];\n",
    "segments": "const _PSEG=(()=>{                                                   // flattened into segments once\n const out=[];\n for(const pl of PATHS)for(let i=0;i<pl.length-1;i++){\n  const a=pl[i],b=pl[i+1];\n  out.push({ax:a[0],az:a[1],dx:b[0]-a[0],dz:b[1]-a[1],\n   len2:(b[0]-a[0])*(b[0]-a[0])+(b[1]-a[1])*(b[1]-a[1]),\n   lo:Math.min(a[0],b[0])-8,hi:Math.max(a[0],b[0])+8,zlo:Math.min(a[1],b[1])-8,zhi:Math.max(a[1],b[1])+8});\n }\n return out;\n})();\nfunction pathDist(x,z){\n let best=1e9;\n for(const s of _PSEG){\n  if(x<s.lo||x>s.hi||z<s.zlo||z>s.zhi)continue;                      // cheap reject first\n  let t=((x-s.ax)*s.dx+(z-s.az)*s.dz)/s.len2; t=t<0?0:t>1?1:t;\n  const px=s.ax+s.dx*t-x, pz=s.az+s.dz*t-z;\n  const d=px*px+pz*pz; if(d<best)best=d;\n }\n let distance=Math.sqrt(best);\n for(const q of villageGroundZones){\n  const dx=x-q.x,dz=z-q.z;\n  if(Math.abs(dx)>q.halfX+Math.max(Math.abs(q.minZ),Math.abs(q.maxZ))+8||Math.abs(dz)>q.halfX+Math.max(Math.abs(q.minZ),Math.abs(q.maxZ))+8)continue;\n  const lx=dx*q.cos-dz*q.sin,lz=dx*q.sin+dz*q.cos;\n  const edge=Math.hypot(Math.max(0,Math.abs(lx)-q.halfX),Math.max(0,q.minZ-lz,lz-q.maxZ));\n  distance=Math.min(distance,edge===0?0:edge+2.3);\n }\n return distance;\n}\n",
    "formation": " /* Sedimentary mesas and weathered spires with grounded talus skirts. */\n {\n  let seed=20260906;\n  const rnd=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};\n  for(const kind of ['mesa','hoodoo']){\n   let placed=0;const count=kind==='mesa'?13:26;\n   for(let i=0;i<320&&placed<count;i++){\n    const a=rnd()*Math.PI*2,rr=24+rnd()*108,x=CANYON.x+Math.cos(a)*rr,z=CANYON.z+Math.sin(a)*rr;\n    const radius=kind==='mesa'?7+rnd()*9:.9+rnd()*1.5;\n    if(Math.hypot(x-CANYON.x,z-CANYON.z)<18||pathDist(x,z)<radius+4||Math.abs(z-riverZ(x))<radius*1.3+9)continue;\n    const height=kind==='mesa'?7+rnd()*11:3.5+rnd()*6.5;\n    if(canyonReplacesFormation(x,z,radius)){placed++;continue;}\n    if(kind==='mesa')geology.placeMesa(x,z,radius,height,i+1107);\n    else geology.placeHoodoo(x,z,radius,height,i+3527);\n    colliders.push({x,z,r:radius*.95,height,landform:kind==='mesa'});placed++;   // landform: seeded, the same on every load, so course-clear may bend a route round it\n   }\n  }\n }\n",
    "legacyColliders": " for(const c of colliders){\n  if(c.precise||player.y>=(c.height??Math.max(2.5,c.r*2.5)))continue;\n  if(c.terrainCliff&&groundH(player.pos.x,player.pos.z)+player.y>=c.topY)continue;\n  if(c.climb&&player.onFoot)continue;   // rock she can climb: on foot the rock's own surface stops her or carries her (on-foot)\n  const ox=player.pos.x-c.x,oz=player.pos.z-c.z;\n  const d2=ox*ox+oz*oz,rad=c.r+0.55;\n  if(d2<rad*rad){\n   const d=Math.sqrt(d2);\n   if(d<0.02){\n    player.pos.x=c.x+Math.sin(player.heading+Math.PI)*rad;\n    player.pos.z=c.z+Math.cos(player.heading+Math.PI)*rad;\n   }else{\n    player.pos.x=c.x+ox/d*rad;\n    player.pos.z=c.z+oz/d*rad;\n   }\n  }\n }\n"
  },
