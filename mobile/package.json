{
  "name": "meadowlark-ranch-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local development packaging for Meadowlark Ranch; distribution is gated by release checks.",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "ios:add": "cap add ios",
    "ios:sync": "npm run stage && cap sync ios",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "0.28.2"
  }
}
